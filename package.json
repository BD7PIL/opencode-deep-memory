{
  "name": "@bd7pil/opencode-deep-memory",
  "version": "0.16.3",
  "description": "Persistent context intelligence for OpenCode (v1 and v2) — cross-session memory, compaction checkpoints, context reconstruction.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BD7PIL/opencode-deep-memory.git"
  },
  "files": [
    "dist",
    "index.js",
    "provision.json",
    ".opencode",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "verify": "npm run typecheck && npm run build && npm test && npm run smoke && npm run e2e",
    "verify:release": "npm run verify && npm run e2e:real-bugs && npm run e2e:v2",
    "prepublishOnly": "npm run build",
    "e2e:real-bugs": "node scripts/e2e-real-bugs.mjs",
    "e2e:v2": "node scripts/e2e-v2-lab.mjs",
    "measure:summary-placement": "tsx scripts/measure-summary-placement.mts"
  },
  "keywords": [
    "opencode",
    "memory",
    "context",
    "bm25",
    "fts",
    "plugin",
    "persistent-memory"
  ],
  "license": "MIT",
  "devDependencies": {
    "@opencode-ai/plugin": "*",
    "@opencode-ai/sdk": "*",
    "@types/node": "^20.11.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "zod": "^4.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
